---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings, getFeaturedReport, getPublishedReports, getCategories } from '../lib/db.ts';

const settings = getSiteSettings();
const featuredReport = getFeaturedReport();
const { reports: recentReports } = getPublishedReports({ limit: 4 });
const categories = getCategories();

// Filter out featured from recent list so it's not duplicated
const displayReports = featuredReport
  ? recentReports.filter((r) => r.id !== featuredReport.id).slice(0, 3)
  : recentReports.slice(0, 3);
---

<Layout
  title={`${settings.site_title} | ${settings.site_tagline}`}
  description={settings.site_description}
>
  <div class="site-container">
    <!-- Editorial Hero -->
    <section class="hero-section">
      <div class="hero-content">
        <p class="eyebrow-label">Independent Research &amp; Intelligence</p>
        <h1 class="hero-title">{settings.site_tagline}</h1>
        <p class="hero-lead">
          0served investigates markets, companies, industries, competitive dynamics, and technological transitions.
          We turn fragmented information into structured evidence, rigorous analysis, and useful intelligence.
        </p>
        <div class="hero-actions">
          <a href="/research" class="btn btn-primary">Examine Research &rarr;</a>
          <a href="/about" class="btn btn-secondary">Methodology &amp; Principles</a>
        </div>
      </div>
    </section>

    <div class="editorial-divider"></div>

    <!-- Featured Research Report -->
    {featuredReport ? (
      <section class="featured-section" aria-labelledby="featured-title">
        <div class="section-label-row">
          <p class="eyebrow-label" id="featured-title">Featured Investigation</p>
          <span class="eyebrow-label">{featuredReport.category_name}</span>
        </div>

        <article class="featured-card">
          <div class="featured-body">
            <div class="featured-meta">
              <time datetime={featuredReport.published_at || featuredReport.created_at}>
                {featuredReport.published_at || featuredReport.created_at.slice(0, 10)}
              </time>
              <span class="meta-sep">&middot;</span>
              <span>{featuredReport.reading_time_minutes} min read</span>
            </div>

            <h2 class="featured-heading">
              <a href={`/research/${featuredReport.slug}`}>
                {featuredReport.title}
              </a>
            </h2>

            {featuredReport.subtitle && (
              <p class="featured-subtitle">{featuredReport.subtitle}</p>
            )}

            <p class="featured-summary">{featuredReport.summary}</p>

            <div class="featured-footer">
              <a href={`/research/${featuredReport.slug}`} class="read-link">
                Read Complete Report &rarr;
              </a>
            </div>
          </div>

          <div class="featured-graphic" aria-hidden="true">
            <div class="graphic-frame">
              <span class="graphic-badge">Evidence Dossier</span>
              <div class="graphic-lines">
                <div class="g-line w-80"></div>
                <div class="g-line w-100"></div>
                <div class="g-line w-60"></div>
                <div class="g-line w-90"></div>
              </div>
              <div class="graphic-data-row">
                <span>Empirical Telemetry</span>
                <span>Active File</span>
              </div>
            </div>
          </div>
        </article>
      </section>
    ) : (
      <section class="empty-state">
        <p class="eyebrow-label">Publications</p>
        <p>No featured research reports are currently active.</p>
      </section>
    )}

    <!-- Recent Publications Grid -->
    {displayReports.length > 0 && (
      <section class="recent-section">
        <div class="section-header-row">
          <div>
            <p class="eyebrow-label">Recent Releases</p>
            <h2 class="section-heading">Analytical Dispatches</h2>
          </div>
          <a href="/research" class="view-all-link">All Reports &rarr;</a>
        </div>

        <div class="reports-grid">
          {displayReports.map((report) => (
            <article class="report-card">
              <div class="card-meta">
                <span class="card-category">{report.category_name}</span>
                <span class="meta-sep">&middot;</span>
                <time datetime={report.published_at || report.created_at}>
                  {report.published_at || report.created_at.slice(0, 10)}
                </time>
              </div>
              <h3 class="card-title">
                <a href={`/research/${report.slug}`}>{report.title}</a>
              </h3>
              <p class="card-summary">{report.summary}</p>
              <div class="card-footer">
                <span class="read-time">{report.reading_time_minutes} min read</span>
                <a href={`/research/${report.slug}`} class="card-read-link">Read &rarr;</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    <!-- Focus Areas / Markets -->
    <section class="markets-overview-section">
      <div class="section-header-row">
        <div>
          <p class="eyebrow-label">Research Domains</p>
          <h2 class="section-heading">Areas of Investigation</h2>
        </div>
        <a href="/markets" class="view-all-link">Explore Markets &rarr;</a>
      </div>

      <div class="markets-grid">
        {categories.map((cat) => (
          <div class="market-box">
            <h3 class="market-name">
              <a href={`/research?category=${cat.slug}`}>{cat.name}</a>
            </h3>
            <p class="market-desc">{cat.description}</p>
            <div class="market-footer">
              <span class="report-badge">
                {cat.report_count ?? 0} {cat.report_count === 1 ? 'publication' : 'publications'}
              </span>
              <a href={`/research?category=${cat.slug}`} class="market-arrow">&rarr;</a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Archive Route Banner -->
    <section class="archive-callout-section">
      <div class="archive-callout-inner">
        <div>
          <h2 class="archive-callout-title">The Complete Research Archive</h2>
          <p class="archive-callout-text">
            Search, filter by industry domain, and review chronological publications from 0served's ongoing investigations.
          </p>
        </div>
        <a href="/archive" class="btn btn-primary">Access Full Archive &rarr;</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero-section {
    padding: 5rem 0 3.5rem;
  }

  .hero-content {
    max-width: 820px;
  }

  .hero-title {
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1.15;
    margin: 1rem 0 1.5rem;
    letter-spacing: -0.025em;
  }

  .hero-lead {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--text-secondary);
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Featured Section */
  .featured-section {
    padding: 2.5rem 0 4rem;
  }

  .section-label-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .featured-card {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 3.5rem;
    align-items: center;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 3rem;
  }

  .featured-meta {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .meta-sep {
    color: var(--border-subtle);
  }

  .featured-heading {
    font-size: 2.15rem;
    line-height: 1.25;
    margin-bottom: 0.85rem;
  }

  .featured-heading a {
    text-decoration: none;
    color: var(--text-primary);
  }

  .featured-heading a:hover {
    color: var(--color-accent);
  }

  .featured-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    font-style: italic;
  }

  .featured-summary {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .read-link {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
  }

  .read-link:hover {
    text-decoration: underline;
  }

  /* Graphic Frame */
  .featured-graphic {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .graphic-frame {
    width: 100%;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.75rem;
  }

  .graphic-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background-color: var(--color-accent-subtle);
    color: var(--color-accent);
    padding: 0.2rem 0.5rem;
    margin-bottom: 1.5rem;
  }

  .graphic-lines {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .g-line {
    height: 4px;
    background-color: var(--border-subtle);
    border-radius: 2px;
  }

  .w-80 { width: 80%; }
  .w-100 { width: 100%; }
  .w-60 { width: 60%; }
  .w-90 { width: 90%; }

  .graphic-data-row {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
  }

  /* Recent Grid */
  .recent-section,
  .markets-overview-section {
    padding: 3.5rem 0;
  }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .section-heading {
    font-size: 1.85rem;
    margin-top: 0.35rem;
  }

  .view-all-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .view-all-link:hover {
    color: var(--text-primary);
  }

  .reports-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .report-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
  }

  .card-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .card-title {
    font-size: 1.3rem;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .card-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .card-title a:hover {
    color: var(--color-accent);
  }

  .card-summary {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.85rem;
    font-size: 0.8125rem;
  }

  .read-time {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .card-read-link {
    font-weight: 600;
    color: var(--color-accent);
  }

  /* Markets Grid */
  .markets-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
  }

  .market-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .market-name {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }

  .market-name a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .market-name a:hover {
    color: var(--color-accent);
  }

  .market-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .market-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 0.85rem;
  }

  .report-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .market-arrow {
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Archive Callout */
  .archive-callout-section {
    padding: 3rem 0 5rem;
  }

  .archive-callout-inner {
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 3rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 3rem;
  }

  .archive-callout-title {
    font-size: 1.85rem;
    margin-bottom: 0.5rem;
  }

  .archive-callout-text {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .featured-card {
      grid-template-columns: 1fr;
      padding: 2rem;
    }

    .featured-graphic {
      display: none;
    }

    .reports-grid {
      grid-template-columns: 1fr;
    }

    .markets-grid {
      grid-template-columns: 1fr;
    }

    .archive-callout-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.5rem;
      padding: 2rem;
    }

    .hero-title {
      font-size: 2.35rem;
    }
  }
</style>
