---
import Layout from '../../layouts/Layout.astro';
import { getPublishedReports, getCategories, getSiteSettings } from '../../lib/db.ts';

const settings = getSiteSettings();
const categories = getCategories();

const currentCategorySlug = Astro.url.searchParams.get('category') || '';
const currentSort = Astro.url.searchParams.get('sort') === 'oldest' ? 'oldest' : 'newest';
const pageParam = parseInt(Astro.url.searchParams.get('page') || '1', 10);
const currentPage = isNaN(pageParam) || pageParam < 1 ? 1 : pageParam;
const pageSize = 9;
const offset = (currentPage - 1) * pageSize;

const { reports, total } = getPublishedReports({
  categorySlug: currentCategorySlug || undefined,
  sort: currentSort,
  limit: pageSize,
  offset: offset,
});

const totalPages = Math.ceil(total / pageSize);
const selectedCategory = currentCategorySlug
  ? categories.find((c) => c.slug === currentCategorySlug)
  : null;
---

<Layout
  title={selectedCategory ? `${selectedCategory.name} Research | 0served` : `Research Publications | 0served`}
  description="Examine 0served's published research reports, forensic investigations, and strategic analysis."
>
  <div class="site-container">
    <div class="listing-header">
      <p class="eyebrow-label">Intelligence Dossier</p>
      <h1 class="listing-title">
        {selectedCategory ? selectedCategory.name : 'Research Publications'}
      </h1>
      <p class="listing-lead">
        {selectedCategory
          ? selectedCategory.description
          : 'Structured investigations into corporate governance, capital intensity, competitive moats, and structural market transitions.'}
      </p>
    </div>

    <!-- Filter & Sort Bar -->
    <div class="filter-sort-bar">
      <div class="category-pills" role="navigation" aria-label="Filter by Research Domain">
        <a
          href={`/research?sort=${currentSort}`}
          class:list={['filter-pill', { active: !currentCategorySlug }]}
        >
          All Domains ({total})
        </a>
        {categories.map((cat) => (
          <a
            href={`/research?category=${cat.slug}&sort=${currentSort}`}
            class:list={['filter-pill', { active: currentCategorySlug === cat.slug }]}
          >
            {cat.name} {cat.report_count !== undefined && cat.report_count > 0 ? `(${cat.report_count})` : ''}
          </a>
        ))}
      </div>

      <div class="sort-control">
        <label for="sort-select" class="sort-label">Sort:</label>
        <select
          id="sort-select"
          onchange="window.location.href = this.value"
          class="sort-dropdown"
        >
          <option
            value={`/research?${currentCategorySlug ? `category=${currentCategorySlug}&` : ''}sort=newest`}
            selected={currentSort === 'newest'}
          >
            Newest First
          </option>
          <option
            value={`/research?${currentCategorySlug ? `category=${currentCategorySlug}&` : ''}sort=oldest`}
            selected={currentSort === 'oldest'}
          >
            Oldest First
          </option>
        </select>
      </div>
    </div>

    <!-- Reports Listing -->
    {reports.length > 0 ? (
      <div class="publications-grid">
        {reports.map((report) => (
          <article class="pub-card">
            <div class="pub-header">
              <span class="pub-domain">{report.category_name}</span>
              <span class="meta-sep">&middot;</span>
              <time datetime={report.published_at || report.created_at}>
                {report.published_at || report.created_at.slice(0, 10)}
              </time>
            </div>

            <h2 class="pub-title">
              <a href={`/research/${report.slug}`}>{report.title}</a>
            </h2>

            {report.subtitle && <p class="pub-subtitle">{report.subtitle}</p>}

            <p class="pub-summary">{report.summary}</p>

            <div class="pub-footer">
              <span class="read-duration">{report.reading_time_minutes} min read</span>
              <a href={`/research/${report.slug}`} class="pub-cta">
                Read Report &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-results-box">
        <p class="empty-title">No published research found in this category.</p>
        <p class="empty-desc">
          0served maintains strict publication standards and does not publish placeholder material.
          Select another category or view all publications.
        </p>
        <a href="/research" class="btn btn-secondary btn-sm">Clear Filter</a>
      </div>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="pagination-bar" aria-label="Pagination">
        {currentPage > 1 ? (
          <a
            href={`/research?${currentCategorySlug ? `category=${currentCategorySlug}&` : ''}sort=${currentSort}&page=${currentPage - 1}`}
            class="btn btn-secondary btn-sm"
          >
            &larr; Previous
          </a>
        ) : (
          <span class="btn btn-secondary btn-sm disabled">&larr; Previous</span>
        )}

        <span class="page-indicator">
          Page {currentPage} of {totalPages}
        </span>

        {currentPage < totalPages ? (
          <a
            href={`/research?${currentCategorySlug ? `category=${currentCategorySlug}&` : ''}sort=${currentSort}&page=${currentPage + 1}`}
            class="btn btn-secondary btn-sm"
          >
            Next &rarr;
          </a>
        ) : (
          <span class="btn btn-secondary btn-sm disabled">Next &rarr;</span>
        )}
      </nav>
    )}
  </div>
</Layout>

<style>
  .listing-header {
    padding: 4.5rem 0 2.5rem;
    max-width: 800px;
  }

  .listing-title {
    font-size: 2.75rem;
    line-height: 1.2;
    margin: 0.85rem 0 1rem;
  }

  .listing-lead {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* Filter & Sort Bar */
  .filter-sort-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    padding: 1rem 0;
    margin-bottom: 3rem;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .category-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-pill {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-secondary);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .filter-pill:hover {
    border-color: var(--text-primary);
    color: var(--text-primary);
  }

  .filter-pill.active {
    background-color: var(--text-primary);
    color: var(--bg-surface);
    border-color: var(--text-primary);
  }

  .sort-control {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .sort-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 0;
  }

  .sort-dropdown {
    font-size: 0.8125rem;
    padding: 0.35rem 0.65rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    width: auto;
  }

  /* Publications Grid */
  .publications-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.25rem;
    margin-bottom: 4rem;
  }

  .pub-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .pub-header {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pub-title {
    font-size: 1.45rem;
    line-height: 1.3;
    margin-bottom: 0.65rem;
  }

  .pub-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .pub-title a:hover {
    color: var(--color-accent);
  }

  .pub-subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-style: italic;
  }

  .pub-summary {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.75rem;
    flex-grow: 1;
  }

  .pub-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding-top: 1rem;
    font-size: 0.8125rem;
  }

  .read-duration {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .pub-cta {
    font-weight: 600;
    color: var(--color-accent);
  }

  .empty-results-box {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 3.5rem 2rem;
    text-align: center;
    max-width: 600px;
    margin: 2rem auto 5rem;
  }

  .empty-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
    color: var(--text-primary);
  }

  .empty-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .pagination-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--border-subtle);
    padding: 1.5rem 0 4rem;
  }

  .page-indicator {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .disabled {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  @media (max-width: 992px) {
    .publications-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .publications-grid {
      grid-template-columns: 1fr;
    }

    .filter-sort-bar {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
