---
import BaseHead from '../components/BaseHead.astro';
import { validateSession, SESSION_COOKIE_NAME } from '../lib/auth.ts';

interface Props {
  title: string;
}

const { title } = Astro.props;

// Fetch authenticated owner
const sessionCookie = Astro.cookies.get(SESSION_COOKIE_NAME)?.value;
const auth = validateSession(sessionCookie);
const userEmail = auth ? auth.user.email : 'owner@oserved.com';

const pathname = Astro.url.pathname;
const isActive = (path: string) => {
  if (path === '/admin') return pathname === '/admin';
  return pathname.startsWith(path);
};
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`${title} | 0served Desk`}
      description="0served Editorial Administration Portal"
    />
  </head>
  <body class="admin-body">
    <!-- Admin Topbar -->
    <header class="admin-topbar">
      <div class="admin-container topbar-inner">
        <div class="topbar-left">
          <a href="/admin" class="admin-brand">
            <span class="brand-zero">0</span>served <span class="desk-pill">DESK</span>
          </a>

          <nav class="admin-nav" aria-label="Admin Navigation">
            <a href="/admin" class:list={['admin-nav-link', { active: isActive('/admin') && pathname === '/admin' }]}>
              Dashboard
            </a>
            <a href="/admin/reports" class:list={['admin-nav-link', { active: isActive('/admin/reports') }]}>
              Reports
            </a>
            <a href="/admin/categories" class:list={['admin-nav-link', { active: isActive('/admin/categories') }]}>
              Categories
            </a>
            <a href="/admin/media" class:list={['admin-nav-link', { active: isActive('/admin/media') }]}>
              Media
            </a>
            <a href="/admin/inquiries" class:list={['admin-nav-link', { active: isActive('/admin/inquiries') }]}>
              Inquiries
            </a>
            <a href="/admin/settings" class:list={['admin-nav-link', { active: isActive('/admin/settings') }]}>
              Settings
            </a>
          </nav>
        </div>

        <div class="topbar-right">
          <a href="/" target="_blank" class="live-site-link" title="Open live public site">
            <span>View Public Site</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>

          <div class="user-chip">
            <span class="user-email">{userEmail}</span>
            <button id="logout-btn" class="logout-btn" title="Sign out of editorial desk">Sign Out</button>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Body -->
    <main class="admin-main">
      <div class="admin-container">
        <slot />
      </div>
    </main>

    <script>
      const logoutBtn = document.getElementById('logout-btn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          if (confirm('Sign out of the editorial desk?')) {
            try {
              const res = await fetch('/api/admin/auth/logout', { method: 'POST' });
              const data = await res.json();
              window.location.href = data.redirect || '/admin/login';
            } catch {
              window.location.href = '/admin/login';
            }
          }
        });
      }
    </script>

    <style>
      .admin-body {
        background-color: #f7f7f6;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .admin-container {
        width: 100%;
        max-width: 1220px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }

      .admin-topbar {
        background-color: #121214;
        color: #ffffff;
        border-bottom: 1px solid #27272a;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .topbar-inner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        height: 60px;
      }

      .topbar-left {
        display: flex;
        align-items: center;
        gap: 2.5rem;
      }

      .admin-brand {
        font-family: var(--font-sans);
        font-size: 1.25rem;
        font-weight: 700;
        color: #ffffff;
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .brand-zero {
        font-family: var(--font-mono);
      }

      .desk-pill {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        background-color: #27272a;
        color: #a1a1aa;
        padding: 0.15rem 0.45rem;
        border-radius: 2px;
        letter-spacing: 0.08em;
      }

      .admin-nav {
        display: flex;
        gap: 1.5rem;
      }

      .admin-nav-link {
        font-size: 0.875rem;
        color: #a1a1aa;
        text-decoration: none;
        font-weight: 500;
        padding: 0.35rem 0;
        position: relative;
        transition: color var(--transition-fast);
      }

      .admin-nav-link:hover {
        color: #ffffff;
      }

      .admin-nav-link.active {
        color: #ffffff;
        font-weight: 600;
      }

      .admin-nav-link.active::after {
        content: '';
        position: absolute;
        bottom: -18px;
        left: 0;
        right: 0;
        height: 2px;
        background-color: #ffffff;
      }

      .topbar-right {
        display: flex;
        align-items: center;
        gap: 1.5rem;
      }

      .live-site-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.8125rem;
        color: #a1a1aa;
        text-decoration: none;
      }

      .live-site-link:hover {
        color: #ffffff;
      }

      .user-chip {
        display: flex;
        align-items: center;
        gap: 1rem;
        border-left: 1px solid #27272a;
        padding-left: 1.25rem;
      }

      .user-email {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: #a1a1aa;
      }

      .logout-btn {
        background: none;
        border: 1px solid #3f3f46;
        color: #d4d4d8;
        font-size: 0.75rem;
        padding: 0.25rem 0.6rem;
        border-radius: 2px;
        cursor: pointer;
        transition: all var(--transition-fast);
      }

      .logout-btn:hover {
        background-color: #27272a;
        color: #ffffff;
        border-color: #52525b;
      }

      .admin-main {
        padding: 3rem 0 5rem;
        flex-grow: 1;
      }

      @media (max-width: 960px) {
        .admin-nav {
          gap: 1rem;
        }

        .user-email {
          display: none;
        }

        .topbar-left {
          gap: 1.5rem;
        }
      }
    </style>
  </body>
</html>
